/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for attendee-generated content (questions, poll responses)
 * and provides read access to session and poll data. Data is organized under sessions, with questions and polls as subcollections.
 *
 * Data Structure:
 * - /sessions/{sessionId}: Stores session data. Publicly readable.
 * - /sessions/{sessionId}/questions/{questionId}: Stores questions for a session. Only signed-in users can create questions.
 *   Ownership is enforced via the 'authorId' field.
 * - /sessions/{sessionId}/polls/{pollId}: Stores polls for a session. Publicly readable.
 * - /polls/{pollId}/responses/{responseId}: Stores responses to polls.  Only signed-in users can submit one response per poll.
 *   Ownership is enforced via the 'attendeeId' field.
 * - /attendees/{attendeeId}: Stores attendee profiles. Owner-only access.
 *
 * Key Security Decisions:
 * - User listing is disabled for all collections.
 * - Read-only access is granted to session and poll data to facilitate public consumption.
 * - Timestamp validation is omitted for flexible prototyping.
 *
 * Denormalization for Authorization:
 * - Questions: Include 'sessionId' and 'authorId' to avoid get() calls.
 * - PollResponses: Include 'pollId' and 'attendeeId' to avoid get() calls.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is authenticated.
     * @path N/A
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user is the owner of the resource.
     * @path N/A
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is the existing owner of the resource.
     * @path N/A
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Allows read-only access to session data.
     * @path /sessions/{sessionId}
     * @allow (get, list) Any user can read session data.
     * @deny (create, update, delete) No one can create, update, or delete session data directly.
     * @principle Public read access for session information.
     */
    match /sessions/{sessionId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Manages questions within a session.  Authenticated users can create questions,
     *  and only the author can update or delete them.
     * @path /sessions/{sessionId}/questions/{questionId}
     * @allow (create) Authenticated user creates a question with authorId matching their UID and sessionId matching the path.
     * @allow (get, list) Any user can read questions.
     * @allow (update, delete) Author updates/deletes a question if the authorId matches their UID.
     * @deny (create) Non-authenticated user attempts to create a question.
     * @deny (update, delete) Non-author attempts to update/delete a question.
     * @principle Enforces document ownership for writes.
     */
    match /sessions/{sessionId}/questions/{questionId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid && request.resource.data.sessionId == sessionId;
      allow update: if isExistingOwner(resource.data.authorId);
      allow delete: if isExistingOwner(resource.data.authorId);
    }

    /**
     * @description Allows read-only access to poll data.
     * @path /sessions/{sessionId}/polls/{pollId}
     * @allow (get, list) Any user can read poll data.
     * @deny (create, update, delete) No one can create, update, or delete poll data directly.
     * @principle Public read access for poll information.
     */
    match /sessions/{sessionId}/polls/{pollId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Manages poll responses. Authenticated users can create one response per poll,
     *  and only the author can update or delete their response.
     * @path /polls/{pollId}/responses/{responseId}
     * @allow (create) Authenticated user creates a response with attendeeId matching their UID and pollId matching the path.
     * @allow (get, list) No listing allowed, direct get only.
     * @allow (update, delete) Author updates/deletes a response if the attendeeId matches their UID.
     * @deny (create) Non-authenticated user attempts to create a response.
     * @deny (update, delete) Non-author attempts to update/delete a response.
     * @principle Enforces document ownership for writes.
     */
    match /polls/{pollId}/responses/{responseId} {
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn() && request.resource.data.attendeeId == request.auth.uid && request.resource.data.pollId == pollId;
      allow update: if isExistingOwner(resource.data.attendeeId);
      allow delete: if isExistingOwner(resource.data.attendeeId);
    }

    /**
     * @description Manages attendee profiles. Only the owner can read, create, update, or delete their own profile.
     * @path /attendees/{attendeeId}
     * @allow (create) Authenticated user creates their own profile with attendeeId matching their UID.
     * @allow (get, update, delete) Owner can read/update/delete their own profile if attendeeId matches their UID.
     * @deny (create, get, update, delete) Non-owner attempts to access another user's profile.
     * @principle Restricts access to a user's own data tree.
     */
    match /attendees/{attendeeId} {
      allow get: if isOwner(attendeeId);
      allow list: if false;
      allow create: if isOwner(attendeeId);
      allow update: if isExistingOwner(attendeeId);
      allow delete: if isExistingOwner(attendeeId);
    }
  }
}
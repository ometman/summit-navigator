rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check for authentication
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if the user is the owner of an existing resource
    function isOwner(authorId) {
      return request.auth.uid == authorId;
    }

    match /sessions/{sessionId} {
      // Sessions can be read by anyone, but not written to from the client
      allow read: if true;
      allow write: if false;

      match /questions/{questionId} {
        // Allow authenticated users to read (list/get) questions
        allow read: if isAuthenticated();

        // Allow authenticated users to create questions if they are the author
        allow create: if isAuthenticated() && isOwner(request.resource.data.authorId);

        // Allow authenticated users to update or delete questions if they are the owner
        allow update, delete: if isAuthenticated() && isOwner(resource.data.authorId);
      }
    }

    // Speakers can be read by anyone, but not written to from the client
    match /speakers/{speakerId} {
        allow read: if true;
        allow write: if false;
    }
  }
}

/**
 * @fileoverview Firestore Security Rules for the Leadership Summit application.
 *
 * Core Philosophy:
 * This ruleset prioritizes secure data access by enforcing strict ownership and
 * relationship constraints.  Attendees can only manage their own profiles and
 * can only submit questions and poll responses. Data is segregated into collections and
 * subcollections based on entity relationships, ensuring a consistent security posture.
 *
 * Data Structure:
 * - /sessions/{sessionId}: Stores session details.  Serves as the parent for
 *   questions and polls.
 * - /sessions/{sessionId}/questions/{questionId}: Stores questions for a
 *   specific session. Each question includes `sessionId` and `authorId` for
 *   authorization independence.
 * - /sessions/{sessionId}/polls/{pollId}: Stores polls for a specific session.
 *   Each poll includes `sessionId` for authorization.
 * - /polls/{pollId}/responses/{responseId}: Stores poll responses. Includes
 *   `pollId` and `attendeeId` for authorization independence.
 * - /attendees/{attendeeId}: Stores attendee profiles.
 *
 * Key Security Decisions:
 * - Attendees can only create, update, or delete their own profiles.
 * - Only authenticated users can create questions within a session.
 * - Each attendee can submit only one response per poll, enforced by matching
 *   `request.auth.uid` against `attendeeId`.
 * - Listing questions/polls for a session is allowed for all authenticated users.
 * - Data integrity is maintained by enforcing immutability of key fields like
 *   `attendeeId` and `sessionId` after document creation.
 *
 * Denormalization for Authorization:
 * The rules leverage denormalization of `sessionId` and `attendeeId` to avoid
 * costly `get()` calls. This ensures that authorization checks can be performed
 * efficiently.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user ID matches the provided user ID.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is the owner of an existing document.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Rules for the /sessions/{sessionId} collection.
     * @path /sessions/{sessionId}
     * @allow (get, list): Any authenticated user can view session details.
     * @allow (create, update, delete): No one can create, update, or delete sessions via the client. This should be handled by backend services only.
     * @deny (create): An unauthenticated user attempts to create a session.
     * @principle Enforces that sessions can only be managed by backend services.
     */
    match /sessions/{sessionId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if false;
    }

    /**
     * @description Rules for the /sessions/{sessionId}/questions/{questionId} collection.
     * @path /sessions/{sessionId}/questions/{questionId}
     * @allow (create): Authenticated users can create questions for a session, with authorId matching their UID.
     * @allow (get, list): Any authenticated user can read questions for a session.
     * @allow (update, delete): Only the author can update or delete their own question.
     * @deny (create): An unauthenticated user attempts to create a question.
     * @deny (update): A user attempts to update a question they don't own.
     * @principle Enforces document ownership for writes; allows public read access.
     */
    match /sessions/{sessionId}/questions/{questionId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid && request.resource.data.sessionId == sessionId;
      allow update, delete: if isExistingOwner(resource.data.authorId);
    }

    /**
     * @description Rules for the /sessions/{sessionId}/polls/{pollId} collection.
     * @path /sessions/{sessionId}/polls/{pollId}
     * @allow (get, list): Any authenticated user can view polls for a session.
     * @allow (create, update, delete): No one can create, update, or delete polls via the client. This should be handled by backend services only.
     * @deny (create): An unauthenticated user attempts to create a poll.
     * @principle Enforces that polls can only be managed by backend services.
     */
    match /sessions/{sessionId}/polls/{pollId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if false;
    }

    /**
     * @description Rules for the /polls/{pollId}/responses/{responseId} collection.
     * @path /polls/{pollId}/responses/{responseId}
     * @allow (create): Authenticated users can create a response for a poll, with attendeeId matching their UID.
     * @allow (get, list): Any authenticated user can list/get poll responses.
     * @allow (update, delete): Only the author can update or delete their own response.
     * @deny (create): An unauthenticated user attempts to create a poll response.
     * @deny (update): A user attempts to update a poll response they don't own.
     * @principle Enforces document ownership for writes; allows public read access.
     */
    match /polls/{pollId}/responses/{responseId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.attendeeId == request.auth.uid && request.resource.data.pollId == pollId;
      allow update, delete: if isExistingOwner(resource.data.attendeeId);
    }

    /**
     * @description Rules for the /attendees/{attendeeId} collection.
     * @path /attendees/{attendeeId}
     * @allow (create): A user can create their own profile, with attendeeId matching their UID.
     * @allow (get): A user can get their own profile.
     * @allow (update, delete): A user can update or delete their own profile.
     * @deny (create): A user attempts to create a profile with an attendeeId that doesn't match their UID.
     * @deny (update): A user attempts to update a profile that doesn't belong to them.
     * @principle Enforces document ownership for all operations.
     */
    match /attendees/{attendeeId} {
      allow get: if isOwner(attendeeId);
      allow create: if isOwner(attendeeId);
      allow update, delete: if isExistingOwner(attendeeId);
      allow list: if false;
    }
  }
}
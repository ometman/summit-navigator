/**
 * @fileoverview Firestore Security Rules for the Leadership Summit application.
 *
 * Core Philosophy:
 * This ruleset prioritizes attendee access for submitting questions and poll responses while ensuring data integrity and preventing unauthorized modifications.
 * It uses a combination of path-based and data-based authorization. Authenticated users can read session details and submit questions.
 *
 * Data Structure:
 * - /sessions/{sessionId}: Stores session details.
 * - /sessions/{sessionId}/questions/{questionId}: Stores questions for each session.
 * - /sessions/{sessionId}/polls/{pollId}: Stores polls for each session.
 * - /polls/{pollId}/responses/{responseId}: Stores responses to polls.
 * - /attendees/{attendeeId}: Stores attendee profiles.
 *
 * Key Security Decisions:
 * - Authenticated users can submit questions.
 * - Attendee data is secured with owner-only access.
 * - Only authenticated users can create questions, allowing for anonymous submissions.
 *
 * Denormalization for Authorization:
 * - Questions include `authorId` and `sessionId` to avoid `get()` calls for authorization.
 * - PollResponses include `attendeeId` and `pollId` to avoid `get()` calls for authorization.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows reading session details.
     * @path /sessions/{sessionId}
     * @allow (get, list)
     * @deny (create, update, delete)
     * @principle Public read access for session details.
     */
    match /sessions/{sessionId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows authenticated users to submit questions for a specific session.
     * @path /sessions/{sessionId}/questions/{questionId}
     * @allow (create) request.auth.uid != null && request.resource.data.authorId == request.auth.uid && request.resource.data.sessionId == sessionId
     * @allow (get, list)
     * @allow (update, delete)
     * @deny (create) request.resource.data.authorId != request.auth.uid
     * @principle Allows authenticated users to create questions with the correct authorId and sessionId, public read, owner-only updates and deletes.
     */
    match /sessions/{sessionId}/questions/{questionId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid && request.resource.data.sessionId == sessionId;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows reading poll details.
     * @path /sessions/{sessionId}/polls/{pollId}
     * @allow (get, list)
     * @deny (create, update, delete)
     * @principle Public read access for poll details.
     */
    match /sessions/{sessionId}/polls/{pollId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows attendees to submit a single response to a poll.
     * @path /polls/{pollId}/responses/{responseId}
     * @allow (create) request.auth.uid != null && request.resource.data.attendeeId == request.auth.uid && request.resource.data.pollId == pollId
     * @allow (get, list)
     * @allow (update, delete)
     * @deny (create) request.resource.data.attendeeId != request.auth.uid
     * @principle Allows authenticated users to create poll responses with the correct attendeeId and pollId, public read, no updates or deletes.
     */
    match /polls/{pollId}/responses/{responseId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.attendeeId == request.auth.uid && request.resource.data.pollId == pollId;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows an attendee to read and modify their own profile.
     * @path /attendees/{attendeeId}
     * @allow (get, list) if isOwner(attendeeId)
     * @allow (create) if isOwner(attendeeId)
     * @allow (update) if isExistingOwner(attendeeId)
     * @allow (delete) if isExistingOwner(attendeeId)
     * @deny (create) request.auth.uid == null
     * @deny (update, delete) resource == null
     * @principle Enforces document ownership, restricting access to a user's own data tree.
     */
    match /attendees/{attendeeId} {
      allow get: if isOwner(attendeeId);
      allow list: if false;
      allow create: if isOwner(attendeeId);
      allow update: if isExistingOwner(attendeeId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(attendeeId);
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }
  }
}
/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for attendee-generated content (questions, poll responses) and restricts access to specific collections based on user authentication. Sessions and Polls are publicly readable, but only authenticated users can create or modify them.
 *
 * Data Structure:
 * - /sessions/{sessionId}: Stores session details; publicly readable.
 * - /sessions/{sessionId}/questions/{questionId}: Stores questions for a session; owned by the submitting attendee.
 * - /sessions/{sessionId}/polls/{pollId}: Stores polls for a session; publicly readable.
 * - /polls/{pollId}/responses/{responseId}: Stores responses to a poll; owned by the submitting attendee.
 * - /attendees/{attendeeId}: Stores attendee profiles; only accessible to the owning attendee.
 *
 * Key Security Decisions:
 * - Listing questions is allowed for authenticated users.
 * - Listing poll responses is allowed for the owner.
 * - Attendees can only create their own profiles.
 * - Sessions and Polls are publicly readable to allow viewing summit data without authentication.
 *
 * Denormalization for Authorization:
 * - Questions include `authorId` to allow simple owner-based security rules without additional reads.
 * - PollResponses include `attendeeId` to allow simple owner-based security rules without additional reads.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows read-only access to session data.
     * @path /sessions/{sessionId}
     * @allow (get, list)
     * @deny (create, update, delete)
     * @principle Public read, no write access.
     */
    match /sessions/{sessionId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows authenticated users to create questions for a session and restricts modifications/deletion to the question's author.
     * @path /sessions/{sessionId}/questions/{questionId}
     * @allow (create) - User A can create a question in session X.
     * @allow (get, list) - User A can read/list questions in session X.
     * @allow (update, delete) - User A can update/delete their own question.
     * @deny (create) - User A cannot create a question with an `authorId` that doesn't match their own.
     * @deny (update, delete) - User A cannot update/delete a question they don't own.
     * @principle Enforces document ownership for writes; allows public reads.
     */
    match /sessions/{sessionId}/questions/{questionId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isExistingOwner(resource.data.authorId);
    }

    /**
     * @description Allows read-only access to poll data.
     * @path /sessions/{sessionId}/polls/{pollId}
     * @allow (get, list)
     * @deny (create, update, delete)
     * @principle Public read, no write access.
     */
    match /sessions/{sessionId}/polls/{pollId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows an attendee to submit a single response to a poll and restricts modifications/deletion to the response's author.
     * @path /polls/{pollId}/responses/{responseId}
     * @allow (create) - User A can create a response for poll Y.
     * @allow (get, list) - User A can read/list responses in poll Y.
     * @allow (update, delete) - User A can update/delete their own response.
     * @deny (create) - User A cannot create a response with an `attendeeId` that doesn't match their own.
     * @deny (update, delete) - User A cannot update/delete a response they don't own.
     * @principle Enforces document ownership for writes; allows public reads.
     */
    match /polls/{pollId}/responses/{responseId} {
      allow get, list: if isOwner(resource.data.attendeeId);
      allow create: if isSignedIn() && request.resource.data.attendeeId == request.auth.uid;
      allow update, delete: if isExistingOwner(resource.data.attendeeId);
    }

    /**
     * @description Allows an attendee to create and manage their own profile.
     * @path /attendees/{attendeeId}
     * @allow (create) - User A can create an attendee document where the ID matches their auth UID.
     * @allow (get, list, update, delete) - User A can read, list, update, and delete their own attendee document.
     * @deny (create) - User A cannot create an attendee document where the ID does not match their auth UID.
     * @deny (get, list, update, delete) - User A cannot read, list, update, and delete another user's attendee document.
     * @principle Restricts access to a user's own data tree.
     */
    match /attendees/{attendeeId} {
      allow get: if isOwner(attendeeId);
      allow list: if false;
      allow create: if isOwner(attendeeId);
      allow update: if isExistingOwner(attendeeId);
      allow delete: if isExistingOwner(attendeeId);
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isSignedIn() && isOwner(userId) && resource != null;
    }
  }
}
/**
 * @file Firestore Security Rules for Leadership Summit App
 *
 * @core_philosophy:
 *   This ruleset enforces a strict ownership model for attendee-generated content (questions, poll responses),
 *   and a session-based model for polls and questions. Attendee profiles are private and only accessible
 *   to the owning user.
 *
 * @data_structure:
 *   - /sessions/{sessionId}: Stores session details. Serves as the parent for questions and polls.
 *   - /sessions/{sessionId}/questions/{questionId}: Stores questions for a session, owned by an attendee.
 *   - /sessions/{sessionId}/polls/{pollId}: Stores polls for a session.
 *   - /polls/{pollId}/responses/{responseId}: Stores poll responses, owned by an attendee.
 *   - /attendees/{attendeeId}: Stores attendee profiles, only accessible to the owning user.
 *
 * @key_security_decisions:
 *   - User listing is disallowed to protect privacy.
 *   - All write operations require authentication.
 *   - Data consistency between document IDs and internal fields is enforced on creation and updates.
 *
 * @denormalization_for_authorization:
 *   - Questions and PollResponses denormalize 'attendeeId' and 'sessionId' to enable direct ownership checks.
 *   - PollResponses denormalize 'pollId' to enable direct link.
 *
 * @structural_segregation:
 *   - Private user data (attendee profiles) is stored in a separate collection (/attendees) from public session data.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows read-only access to session information.
     * @path /sessions/{sessionId}
     * @allow (get, list): if true - any user can read session data.
     * @deny (create, update, delete): if false - no user can create, update, or delete sessions.
     * @principle: Public read, no writes allowed.
     */
    match /sessions/{sessionId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows attendees to create, read, update, and delete their own questions for a specific session.
     * @path /sessions/{sessionId}/questions/{questionId}
     * @allow (create): if isSignedIn() && request.resource.data.attendeeId == request.auth.uid && request.resource.data.sessionId == sessionId;
     * @allow (get, list): if true - any user can read questions.
     * @allow (update, delete): if isSignedIn() && isExistingOwner(resource.data.attendeeId);
     * @deny (create): if !isSignedIn() || request.resource.data.attendeeId != request.auth.uid || request.resource.data.sessionId != sessionId;
     * @deny (update, delete): if !isSignedIn() || !isExistingOwner(resource.data.attendeeId);
     * @principle: Enforces document ownership for writes, public read access.
     */
    match /sessions/{sessionId}/questions/{questionId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.attendeeId == request.auth.uid && request.resource.data.sessionId == sessionId;
      allow update: if isSignedIn() && isExistingOwner(resource.data.attendeeId);
      allow delete: if isSignedIn() && isExistingOwner(resource.data.attendeeId);
    }

    /**
     * @description Allows read-only access to polls for a specific session.
     * @path /sessions/{sessionId}/polls/{pollId}
     * @allow (get, list): if true - any user can read polls.
     * @deny (create, update, delete): if false - no user can create, update, or delete polls.
     * @principle: Public read, no writes allowed.
     */
    match /sessions/{sessionId}/polls/{pollId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows attendees to create, read, update and delete their own poll responses. Enforces single response per poll per attendee.
     * @path /polls/{pollId}/responses/{responseId}
     * @allow (create): if isSignedIn() && request.resource.data.attendeeId == request.auth.uid && request.resource.data.pollId == pollId;
     * @allow (get): if true - any user can read poll responses.
     * @allow (list): if true - any user can list poll responses.
     * @allow (update, delete): if isSignedIn() && isExistingOwner(resource.data.attendeeId);
     * @deny (create): if !isSignedIn() || request.resource.data.attendeeId != request.auth.uid || request.resource.data.pollId != pollId;
     * @deny (update, delete): if !isSignedIn() || !isExistingOwner(resource.data.attendeeId);
     * @principle: Enforces document ownership, allows a single response per poll per user.
     */
    match /polls/{pollId}/responses/{responseId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.attendeeId == request.auth.uid && request.resource.data.pollId == pollId;
      allow update: if isSignedIn() && isExistingOwner(resource.data.attendeeId);
      allow delete: if isSignedIn() && isExistingOwner(resource.data.attendeeId);
    }

    /**
     * @description Allows attendees to create, read, update, and delete their own profile.
     * @path /attendees/{attendeeId}
     * @allow (create): if isSignedIn() && request.auth.uid == attendeeId;
     * @allow (get): if isSignedIn() && isOwner(attendeeId);
     * @allow (list): if false;
     * @allow (update): if isSignedIn() && isOwner(attendeeId) && resource != null;
     * @allow (delete): if isSignedIn() && isExistingOwner(attendeeId);
     * @deny (create): if !isSignedIn() || request.auth.uid != attendeeId;
     * @deny (get): if !isSignedIn() || !isOwner(attendeeId);
     * @deny (update): if !isSignedIn() || !isOwner(attendeeId) || resource == null;
     * @deny (delete): if !isSignedIn() || !isExistingOwner(attendeeId);
     * @principle: Enforces document ownership, restricts access to user's own data.
     */
    match /attendees/{attendeeId} {
      allow get: if isSignedIn() && isOwner(attendeeId);
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == attendeeId;
      allow update: if isSignedIn() && isOwner(attendeeId) && resource != null;
      allow delete: if isSignedIn() && isExistingOwner(attendeeId);
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }
  }
}
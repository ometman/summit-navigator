/**
 * @fileoverview Firestore Security Rules for the leadership seminar application.
 *
 * Core Philosophy:
 * This ruleset provides public read access to session and speaker data,
 * allowing any user (authenticated or anonymous) to retrieve information.
 * Write access is completely disabled.
 *
 * Data Structure:
 * The data is organized into two top-level collections: /sessions/{sessionId} and /speakers/{speakerId}.
 *
 * Key Security Decisions:
 * - Public Read Access: Both `get` and `list` operations are allowed for all users.
 * - No Write Access: `create`, `update`, and `delete` operations are explicitly denied to all users.
 * - No user-specific or role-based access control is implemented.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows public read access to session data. No write access is allowed.
     * @path /sessions/{sessionId}
     * @allow (get, list) Any user can retrieve session data.
     * @deny (create, update, delete) No user can create, update, or delete session data.
     * @principle Allows public read access. Denies all writes.
     */
    match /sessions/{sessionId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows public read access to speaker data. No write access is allowed.
     * @path /speakers/{speakerId}
     * @allow (get, list) Any user can retrieve speaker data.
     * @deny (create, update, delete) No user can create, update, or delete speaker data.
     * @principle Allows public read access. Denies all writes.
     */
    match /speakers/{speakerId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}
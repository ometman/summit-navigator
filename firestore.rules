/**
 * @file Firestore Security Rules for the Leadership Summit App.
 *
 * Core Philosophy:
 * This ruleset enforces a user-ownership model for attendee-generated content (questions, poll responses)
 * and restricts access based on session and attendee relationships. It prioritizes preventing unauthorized
 * data modification and ensures users can only manage their own data.
 *
 * Data Structure:
 * - /sessions/{sessionId}: Stores session details. Serves as the parent for questions and polls subcollections.
 * - /sessions/{sessionId}/questions/{questionId}: Stores questions submitted for a specific session.
 * - /sessions/{sessionId}/polls/{pollId}: Stores polls created for a specific session.
 * - /polls/{pollId}/responses/{responseId}: Stores poll responses submitted by attendees.
 * - /attendees/{attendeeId}: Stores attendee profiles.
 *
 * Key Security Decisions:
 * - Attendee-generated content (questions, poll responses) is implicitly owned via the attendeeId field.
 * - Users can only create questions and poll responses.
 * - Users can only manage their own Attendee profile.
 * - Listing polls is public for all signed in users.
 * - Writes are not permitted to non-existent documents.
 *
 * Denormalization for Authorization:
 * - Questions, Polls, and PollResponses all include denormalized 'sessionId' and/or 'attendeeId' fields
 *   to allow for authorization checks without additional 'get()' calls.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows reading session details.
     * @path /sessions/{sessionId}
     * @allow (get, list) Any signed-in user can read session details.
     * @deny (create, update, delete) No one can create, update, or delete sessions through the client.
     * @principle Public read access, admin-only writes (backend only).
     */
    match /sessions/{sessionId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if false;
    }

    /**
     * @description Allows attendees to submit questions for a specific session.
     * @path /sessions/{sessionId}/questions/{questionId}
     * @allow (create) Authenticated user can create a question if attendeeId matches their UID and sessionId matches the parent.
     * @allow (get, list) Authenticated user can read the question.
     * @allow (update, delete) No one can update or delete questions through the client.
     * @deny (create) User cannot create a question if attendeeId does not match their UID.
     * @principle Enforces document ownership for writes, allows public read access.
     */
    match /sessions/{sessionId}/questions/{questionId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.attendeeId == request.auth.uid && request.resource.data.sessionId == sessionId;
      allow update, delete: if false;
    }

    /**
     * @description Allows reading polls created for a specific session.
     * @path /sessions/{sessionId}/polls/{pollId}
     * @allow (get, list) Any signed-in user can read the poll.
     * @deny (create, update, delete) No one can create, update, or delete polls through the client.
     * @principle Public read access, admin-only writes (backend only).
     */
    match /sessions/{sessionId}/polls/{pollId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if false;
    }

    /**
     * @description Allows attendees to submit responses to a poll.
     * @path /polls/{pollId}/responses/{responseId}
     * @allow (create) Authenticated user can create a response if attendeeId matches their UID and pollId matches the parent.
     * @allow (get, list) Authenticated user can read the response.
     * @allow (update, delete) No one can update or delete responses through the client.
     * @deny (create) User cannot create a response if attendeeId does not match their UID.
     * @principle Enforces document ownership for writes, allows public read access.
     */
    match /polls/{pollId}/responses/{responseId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.attendeeId == request.auth.uid && request.resource.data.pollId == pollId;
      allow update, delete: if false;
    }

    /**
     * @description Allows attendees to manage their own profile information.
     * @path /attendees/{attendeeId}
     * @allow (get) Any signed-in user can read attendee profiles.
     * @allow (create) Authenticated user can create their own profile if attendeeId matches their UID.
     * @allow (update) Authenticated user can update their profile if attendeeId matches their UID and the document exists.
     * @allow (delete) Authenticated user can delete their profile if attendeeId matches their UID and the document exists.
     * @deny (create) User cannot create a profile for another user.
     * @deny (update) User cannot update another user's profile.
     * @deny (delete) User cannot delete another user's profile.
     * @principle Enforces document ownership for all operations.
     */
    match /attendees/{attendeeId} {
      allow get: if isSignedIn();
      allow create: if isSignedIn() && attendeeId == request.auth.uid;
      allow update: if isSignedIn() && isExistingOwner(attendeeId);
      allow delete: if isSignedIn() && isExistingOwner(attendeeId);
    }

    // --- Helper functions ---

    /**
     * @description Checks if the user is signed in.
     * @return {bool} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user is the owner of the document.
     * @param {string} userId The user ID to check against.
     * @return {bool} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is the owner of the document and the document exists.
     * @param {string} userId The user ID to check against.
     * @return {bool} True if the user is the owner and the document exists, false otherwise.
     */
    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }
  }
}
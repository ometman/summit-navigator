/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a combination of public read access and ownership-based write access for the leadership summit application.
 *
 * Data Structure:
 * - /sessions/{sessionId}: Stores session details. Parent for questions and polls.
 * - /sessions/{sessionId}/questions/{questionId}: Stores questions for a session, with `authorId` for ownership.
 * - /sessions/{sessionId}/polls/{pollId}: Stores polls for a session.
 * - /polls/{pollId}/responses/{responseId}: Stores poll responses, with `attendeeId` for ownership.
 * - /attendees/{attendeeId}: Stores attendee profiles, accessible only to the profile owner.
 *
 * Key Security Decisions:
 * - Public read access to session, questions and polls to facilitate open summit participation.
 * - Attendee-only write access for creating questions and poll responses, enforced via `authorId` and `attendeeId`.
 * - Attendee-only access to their own profile data.
 * - Data consistency checks to ensure that `authorId`, `attendeeId`, `sessionId` and `pollId` matches the path.
 *
 * Denormalization for Authorization:
 * - Questions include `authorId` and `sessionId` to allow direct ownership checks.
 * - PollResponses include `attendeeId` and `pollId` to allow direct ownership checks.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows public read access to session details. Write access is denied.
     * @path /sessions/{sessionId}
     * @allow (get, list)
     * @deny (create, update, delete)
     * @principle Public read, no writes.
     */
    match /sessions/{sessionId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows authenticated users to create, read, and list questions for a specific session. Only the author can update or delete.
     * @path /sessions/{sessionId}/questions/{questionId}
     * @allow (create) User with valid auth can create questions.
     * @allow (get, list)
     * @allow (update, delete) User can update and delete a question only if the signed in user is the original author.
     * @deny (create) User tries to create a question for another user by manipulating the `authorId`.
     * @deny (update, delete) User tries to update or delete a question they don't own.
     * @principle Public read, owner-only writes, validates `authorId` on create.
     */
    match /sessions/{sessionId}/questions/{questionId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(authorId) {
        return isSignedIn() && request.auth.uid == authorId;
      }
      function isExistingOwner(authorId) {
          return isOwner(authorId) && resource != null;
      }
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isExistingOwner(resource.data.authorId);
    }

    /**
     * @description Allows public read access to polls. Write access is denied.
     * @path /sessions/{sessionId}/polls/{pollId}
     * @allow (get, list)
     * @deny (create, update, delete)
     * @principle Public read, no writes.
     */
    match /sessions/{sessionId}/polls/{pollId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows authenticated users to create poll responses. Only the author can update or delete their response.
     * @path /polls/{pollId}/responses/{responseId}
     * @allow (create) User with valid auth can create poll responses.
     * @allow (get, list)
     * @allow (update, delete) User can update and delete a poll response only if the signed in user is the original author.
     * @deny (create) User tries to create a response for another user by manipulating the `attendeeId`.
     * @deny (update, delete) User tries to update or delete a response they don't own.
     * @principle Owner-only access, validates `attendeeId` on create.
     */
    match /polls/{pollId}/responses/{responseId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(attendeeId) {
        return isSignedIn() && request.auth.uid == attendeeId;
      }
      function isExistingOwner(attendeeId) {
        return isOwner(attendeeId) && resource != null;
      }
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.attendeeId == request.auth.uid;
      allow update, delete: if isExistingOwner(resource.data.attendeeId);
    }

    /**
     * @description Allows an attendee to create, read, update, and delete their own profile.
     * @path /attendees/{attendeeId}
     * @allow (create) User with valid auth can create their own profile.
     * @allow (get, list) User can get and list their own profile only.
     * @allow (update, delete) User can update and delete their own profile only.
     * @deny (create) User tries to create a profile for another user by manipulating the `attendeeId`.
     * @deny (get, list, update, delete) User tries to access or modify another user's profile.
     * @principle Owner-only access, validates `attendeeId` on create.
     */
    match /attendees/{attendeeId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(attendeeId) {
        return isSignedIn() && request.auth.uid == attendeeId;
      }
      function isExistingOwner(attendeeId) {
        return isOwner(attendeeId) && resource != null;
      }
      allow get, list: if isOwner(attendeeId);
      allow create: if isOwner(attendeeId);
      allow update, delete: if isExistingOwner(attendeeId);
    }
  }
}
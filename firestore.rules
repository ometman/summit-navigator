/**
 * @fileoverview Firestore Security Rules for the Leadership Summit App.
 *
 * Core Philosophy:
 * This ruleset prioritizes secure data access by enforcing strict ownership and
 * role-based authorization. It leverages denormalization to optimize rule
 * performance and prevent costly `get()` calls. The rules explicitly define
 * read and write permissions for each collection, ensuring that no data is
 * unintentionally exposed.
 *
 * Data Structure:
 * - /sessions/{sessionId}: Stores session details. Parent for questions and polls.
 * - /sessions/{sessionId}/questions/{questionId}: Stores questions for a session.
 * - /sessions/{sessionId}/polls/{pollId}: Stores polls for a session.
 * - /polls/{pollId}/responses/{responseId}: Stores poll responses.
 * - /attendees/{attendeeId}: Stores attendee profiles.
 *
 * Key Security Decisions:
 * - Attendees can only create questions for sessions.
 * - Attendees can only submit one poll response per poll.
 * - Data validation is limited to authorization-critical fields to allow for
 *   rapid iteration during the prototyping phase.
 * - Public listing is disabled for collections containing private user data.
 *
 * Denormalization for Authorization:
 * - Questions and PollResponses include the `sessionId` and `attendeeId` to
 *   enable authorization without `get()` calls.
 *
 * Structural Segregation:
 * - Questions and Polls are stored as subcollections of Sessions to enforce
 *   a clear ownership hierarchy.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Session details.
     * @path /sessions/{sessionId}
     * @allow get: if true;
     * @allow list: if true;
     * @allow create: if false;
     * @deny update: if false;
     * @deny delete: if false;
     * @principle Public read-only access. No writes allowed.
     */
    match /sessions/{sessionId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Questions submitted for a specific session.
     * @path /sessions/{sessionId}/questions/{questionId}
     * @allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid && request.resource.data.sessionId == sessionId;
     * @allow get: if true;
     * @allow list: if true;
     * @deny update: if !isExistingOwner(request.resource.data.authorId);
     * @deny delete: if !isExistingOwner(request.resource.data.authorId);
     * @principle Attendees can create questions; owners can update/delete.
     */
    match /sessions/{sessionId}/questions/{questionId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid && request.resource.data.sessionId == sessionId;
      allow update: if isExistingOwner(resource.data.authorId) && resource.data.authorId == request.auth.uid;
      allow delete: if isExistingOwner(resource.data.authorId) && resource.data.authorId == request.auth.uid;
    }

    /**
     * @description Polls created for a specific session.
     * @path /sessions/{sessionId}/polls/{pollId}
     * @allow get: if true;
     * @allow list: if true;
     * @allow create: if false;
     * @deny update: if false;
     * @deny delete: if false;
     * @principle Public read-only access. No writes allowed.
     */
    match /sessions/{sessionId}/polls/{pollId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Poll responses submitted by attendees.
     * @path /polls/{pollId}/responses/{responseId}
     * @allow create: if isSignedIn();
     * @allow get: if false;
     * @allow list: if false;
     * @deny update: if false;
     * @deny delete: if false;
     * @principle Attendees can create responses; no listing or updates.
     */
    match /polls/{pollId}/responses/{responseId} {
      allow create: if isSignedIn();
      allow get, list, update, delete: if false;
    }

    /**
     * @description Attendee profiles.
     * @path /attendees/{attendeeId}
     * @allow get: if isOwner(attendeeId);
     * @allow list: if false;
     * @allow create: if isOwner(attendeeId);
     * @allow update: if isExistingOwner(attendeeId) && request.auth.uid == attendeeId;
     * @allow delete: if isExistingOwner(attendeeId) && request.auth.uid == attendeeId;
     * @principle Attendees can only access and modify their own profile.
     */
    match /attendees/{attendeeId} {
      allow get: if isOwner(attendeeId);
      allow list: if false;
      allow create: if isOwner(attendeeId);
      allow update: if isExistingOwner(attendeeId) && request.auth.uid == attendeeId;
      allow delete: if isExistingOwner(attendeeId) && request.auth.uid == attendeeId;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }
  }
}
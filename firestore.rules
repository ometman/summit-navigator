/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for attendee-generated content (questions, poll responses)
 * and restricts access to session and poll data to ensure data integrity.
 *
 * Data Structure:
 * - /sessions/{sessionId}: Stores session details. Parent for questions and polls.
 * - /sessions/{sessionId}/questions/{questionId}: Stores questions for a session.
 * - /sessions/{sessionId}/polls/{pollId}: Stores polls for a session.
 * - /polls/{pollId}/responses/{responseId}: Stores poll responses.
 * - /attendees/{attendeeId}: Stores attendee profiles.
 *
 * Key Security Decisions:
 * - Attendees can only create questions and poll responses under their own ID.
 * - Sessions and polls are readable by everyone.
 * - Data consistency is enforced by matching document IDs with the corresponding path parameters.
 * - The rules explicitly deny listing all attendees for privacy reasons.
 *
 * Denormalization for Authorization:
 * - Questions and poll responses include the sessionId and attendeeId, respectively, to avoid costly `get()` calls.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to read session details.
     * @path /sessions/{sessionId}
     * @allow (get, list)
     * @deny (create, update, delete)
     * @principle Public read access for session information.
     */
    match /sessions/{sessionId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows authenticated users to create questions for a session, enforcing ownership via authorId.
     * @path /sessions/{sessionId}/questions/{questionId}
     * @allow (create) User with matching authorId can create a question. Example: request.auth.uid = "user123", request.resource.data.authorId = "user123"
     * @deny (create) User attempting to create a question with a mismatched authorId. Example: request.auth.uid = "user456", request.resource.data.authorId = "user123"
     * @allow (get, list)
     * @deny (update, delete)
     * @principle Enforces document ownership for writes, allows public reads.
     */
    match /sessions/{sessionId}/questions/{questionId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid && request.resource.data.sessionId == sessionId;
      allow update, delete: if false;
    }

    /**
     * @description Allows anyone to read poll details.
     * @path /sessions/{sessionId}/polls/{pollId}
     * @allow (get, list)
     * @deny (create, update, delete)
     * @principle Public read access for poll information.
     */
    match /sessions/{sessionId}/polls/{pollId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows an attendee to create a single poll response per poll, enforcing ownership via attendeeId.
     * @path /polls/{pollId}/responses/{responseId}
     * @allow (create) User with matching attendeeId can create a response. Example: request.auth.uid = "user123", request.resource.data.attendeeId = "user123"
     * @deny (create) User attempting to create a response with a mismatched attendeeId. Example: request.auth.uid = "user456", request.resource.data.attendeeId = "user123"
     * @allow (get)
     * @allow (list)
     * @deny (update, delete)
     * @principle Enforces document ownership for writes, allows public reads.
     */
    match /polls/{pollId}/responses/{responseId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.attendeeId == request.auth.uid && request.resource.data.pollId == pollId;
      allow update, delete: if false;
    }

    /**
     * @description Allows an attendee to create their own profile, and prevents listing all attendees.
     * @path /attendees/{attendeeId}
     * @allow (create) User creating their own profile. Example: request.auth.uid = "user123", attendeeId = "user123"
     * @deny (create) User attempting to create a profile for another user. Example: request.auth.uid = "user456", attendeeId = "user123"
     * @allow (get, update, delete) if the user id matches the document id
     * @deny (list) Listing attendees is not allowed
     * @principle Restricts access to a user's own data tree, prevents listing all users.
     */
    match /attendees/{attendeeId} {
      allow get: if isOwner(attendeeId);
      allow create: if isSignedIn() && isOwner(attendeeId);
      allow update: if isOwner(attendeeId);
      allow delete: if isOwner(attendeeId);
      allow list: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }
  }
}
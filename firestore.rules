/**
 * @description This ruleset enforces a strict model where authenticated users can only create, read, update and delete questions associated with a session.
 * @path /sessions/{sessionId}/questions/{questionId}
 * @allow (create) - An authenticated user can create a question under a session.
 * @deny (create) - An unauthenticated user cannot create a question.
 * @principle Requires authentication for all access.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows authenticated users to manage questions within a session.
     * @path /sessions/{sessionId}/questions/{questionId}
     * @allow get - Any authenticated user can read a question.
     * @allow list - Any authenticated user can list questions for a session.
     * @allow create - Any authenticated user can create a question.
     * @allow update - Any authenticated user can update a question.
     * @allow delete - Any authenticated user can delete a question.
     * @deny get - An unauthenticated user cannot read a question.
     * @deny list - An unauthenticated user cannot list questions.
     * @deny create - An unauthenticated user cannot create a question.
     * @deny update - An unauthenticated user cannot update a question.
     * @deny delete - An unauthenticated user cannot delete a question.
     * @principle Requires authentication for all access.
     */
    match /sessions/{sessionId}/questions/{questionId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }


    /**
     * @description Allows authenticated users to manage responses within a session.
     * @path /sessions/{sessionId}/polls/{pollId}
     * @allow get - Any authenticated user can read a poll.
     * @allow list - Any authenticated user can list polls for a session.
     * @allow create - Any authenticated user can create a poll.
     * @allow update - Any authenticated user can update a poll.
     * @allow delete - Any authenticated user can delete a poll.
     * @deny get - An unauthenticated user cannot read a poll.
     * @deny list - An unauthenticated user cannot list polls.
     * @deny create - An unauthenticated user cannot create a poll.
     * @deny update - An unauthenticated user cannot update a poll.
     * @deny delete - An unauthenticated user cannot delete a poll.
     * @principle Requires authentication for all access.
     */
    match /sessions/{sessionId}/polls/{pollId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }


     /**
      * @description This rule allows authenticated users to read and list sessions.  Create, update, and delete are not permitted.
      * @path /sessions/{sessionId}
      * @allow get - Any authenticated user can read a session.
      * @allow list - Any authenticated user can list sessions.
      * @deny create - An unauthenticated user cannot create a session.
      * @deny update - An unauthenticated user cannot update a session.
      * @deny delete - An unauthenticated user cannot delete a session.
      * @principle Requires authentication for all access.
      */
    match /sessions/{sessionId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows authenticated users to manage responses within a poll.
     * @path /polls/{pollId}/responses/{responseId}
     * @allow get - Any authenticated user can read a poll response.
     * @allow list - Any authenticated user can list poll responses.
     * @allow create - Any authenticated user can create a poll response.
     * @allow update - Any authenticated user can update a poll response.
     * @allow delete - Any authenticated user can delete a poll response.
     * @deny get - An unauthenticated user cannot read a poll response.
     * @deny list - An unauthenticated user cannot list poll responses.
     * @deny create - An unauthenticated user cannot create a poll response.
     * @deny update - An unauthenticated user cannot update a poll response.
     * @deny delete - An unauthenticated user cannot delete a poll response.
     * @principle Requires authentication for all access.
     */
    match /polls/{pollId}/responses/{responseId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }


     /**
      * @description Allows authenticated users to read and list attendees.  Create, update, and delete are not permitted.
      * @path /attendees/{attendeeId}
      * @allow get - Any authenticated user can read a attendee.
      * @allow list - Any authenticated user can list attendees.
      * @deny create - An unauthenticated user cannot create a attendee.
      * @deny update - An unauthenticated user cannot update a attendee.
      * @deny delete - An unauthenticated user cannot delete a attendee.
      * @principle Requires authentication for all access.
      */
      match /attendees/{attendeeId} {
        allow get: if isSignedIn();
        allow list: if isSignedIn();
        allow create: if false;
        allow update: if false;
        allow delete: if false;
      }
  }

  function isSignedIn() {
    return request.auth != null;
  }
}
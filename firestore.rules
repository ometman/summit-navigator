/**
 * @fileoverview Firestore Security Rules for the leadership seminar application.
 *
 * Core Philosophy:
 * This ruleset provides open read access to all data (sessions and speakers) while restricting all write access to authenticated users.
 *
 * Data Structure:
 * The data is organized into two top-level collections: /sessions/{sessionId} and /speakers/{speakerId}.
 *
 * Key Security Decisions:
 * - Open read access: Both `get` and `list` operations are allowed for all users, including unauthenticated users.
 * - Authenticated writes: Only authenticated users can create, update, or delete documents.
 * - No data validation: No schema validation is performed. This allows for rapid prototyping and iteration.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to read session information.  Only authenticated users can create, update, or delete sessions.
     * @path /sessions/{sessionId}
     * @allow (get, list): Any user can read session data.
     * @allow (create, update, delete): Authenticated user can create, update, and delete session data.
     * @deny (create, update, delete): Unauthenticated user cannot create, update or delete session data.
     * @principle Allows open reads for all users but restricts writes to authenticated users.
     */
    match /sessions/{sessionId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Allows anyone to read speaker information. Only authenticated users can create, update, or delete speakers.
     * @path /speakers/{speakerId}
     * @allow (get, list): Any user can read speaker data.
     * @allow (create, update, delete): Authenticated user can create, update and delete speaker data.
     * @deny (create, update, delete): Unauthenticated user cannot create, update, or delete speaker data.
     * @principle Allows open reads for all users but restricts writes to authenticated users.
     */
    match /speakers/{speakerId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }


    /**
     * @description Allows authenticated users to read or list questions under a session.  Authenticated users can create questions with a valid authorId and sessionId, and update/delete existing questions if they are the owner.
     * @path /sessions/{sessionId}/questions/{questionId}
     * @allow (get, list): Authenticated user can read questions under a session.
     * @allow (create): Authenticated user can create questions with a valid authorId and sessionId.
     * @allow (update, delete): Authenticated user can update/delete existing questions if they are the owner.
     * @deny (create): Unauthenticated user cannot create questions.
     * @deny (update, delete): Unauthenticated user cannot update/delete existing questions.
     * @principle Enforces authentication for write operations, ownership for updates and deletes.
     */
    match /sessions/{sessionId}/questions {
      allow list, get: if isSignedIn();

      match /{questionId} {
        allow read, write: if isSignedIn();

        allow create: if isSignedIn() 
                        && request.resource.data.authorId == request.auth.uid 
                        && request.resource.data.sessionId == sessionId;

        allow update, delete: if isExistingOwner(resource.data.authorId);
      }
    }
  }

  // Helper function to determine if the user is signed in
  function isSignedIn() {
    return request.auth != null;
  }

  // Helper function to determine if the user is the owner of the resource and if the document exists
  function isExistingOwner(userId) {
    return (isSignedIn() && request.auth.uid == userId && resource != null);
  }
}